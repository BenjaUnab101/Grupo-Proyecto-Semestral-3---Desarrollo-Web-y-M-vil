# Dirección base de la API REST del Hito 3 (FastAPI). Copiar a .env y ajustar.
# Después de cambiar .env: reiniciar `npm run dev` (web) o ejecutar `npm run android:sync` (APK).

# Navegador en el PC
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_WEB=http://localhost:8000/api/v1

# App Android (Capacitor)
#  - Emulador de Android Studio: 10.0.2.2 es el "localhost" del PC.
VITE_API_ANDROID=http://10.0.2.2:8000/api/v1
#  - Teléfono físico en la misma red Wi-Fi: usar la IP del PC (ipconfig en Windows), por ejemplo:
# VITE_API_ANDROID=http://192.168.1.50:8000/api/v1
