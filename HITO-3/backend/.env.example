# Copiar a .env (que NO se sube a Git) y cambiar los valores marcados "cambiar".
# Todos los valores de ejemplo son ficticios.

# R4 · Matiz A: OBLIGATORIO. Valores válidos: development | test | staging | production.
# Sin APP_ENV, o con un valor desconocido, la API no inicia. Solo development/test admiten
# credenciales e identidad demo, y solo si se activan explícitamente más abajo.
APP_ENV=development
API_PREFIX=/api/v1

# ---------- docker compose (TEC-19) ----------
POSTGRES_DB=pequenos_reyes
POSTGRES_USER=pequenos_reyes
POSTGRES_PASSWORD=cambiar-esta-clave-local
# Puertos publicados en el equipo (cambiarlos si ya están ocupados).
FRONTEND_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
MONGO_PORT=27017
# Remediación BD: MongoDB con autenticación. root solo administra; la API usa la cuenta app
# (readWrite solo en pequenos_reyes). Contraseñas: solo letras, números, '-' y '_' (van en URLs).
MONGO_ROOT_USER=pr_root
MONGO_ROOT_PASSWORD=cambiar-clave-root-mongo
MONGO_APP_USER=pr_api
MONGO_APP_PASSWORD=cambiar-clave-app-mongo
VITE_API_URL=http://localhost:8000/api/v1

# ---------- API fuera de Docker (uvicorn local) ----------
DATABASE_URL=postgresql+psycopg://pequenos_reyes:cambiar-esta-clave-local@localhost:5432/pequenos_reyes
MONGODB_URL=mongodb://pr_api:cambiar-clave-app-mongo@localhost:27017/pequenos_reyes?authSource=pequenos_reyes
MONGODB_DATABASE=pequenos_reyes
CORS_ORIGINS=http://localhost:5173

# ---------- HU-16: login real ----------
# Contraseña de las cuentas FICTICIAS @ejemplo.cl (solo development/test).
# Vacía = esas cuentas no pueden iniciar sesión. Con APP_ENV=staging/production la API no inicia
# si está definida, y las cuentas @ejemplo.cl y sus sesiones se rechazan siempre (R4 · Matiz B).
DEMO_PASSWORD=
SESION_MINUTOS=120
# Identidad demo de TEC-17 (X-Usuario-Id) y X-Rol sin sesión. Por defecto: false (solo login real).
# Ponerla en true SOLO en development/test si se usa la barra demo o los scripts que dependen de ella;
# con staging/production la API no inicia si está en true. Aun en true, X-Usuario-Id solo puede
# actuar como cuentas @ejemplo.cl y X-Rol debe coincidir con la sesión si la hay.
PERMITIR_IDENTIDAD_DEMO=false

# ---------- HU-22: bitácora de auditoría (MongoDB) ----------
AUDITORIA_RETENCION_DIAS=365

# ---------- Segunda auditoría (H-04): red y entorno ----------
# Interfaz donde se publican los puertos. 127.0.0.1 = solo este equipo (recomendado).
# Usar 0.0.0.0 solo en una red de confianza y nunca con PERMITIR_IDENTIDAD_DEMO=true.
BIND_HOST=127.0.0.1
